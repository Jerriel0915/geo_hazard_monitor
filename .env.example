# ============================================
# 环境变量模板
# 复制此文件为 .env 并填写真实值
# 重要：勿将 .env 提交到 Git
# ============================================

# ---------- MySQL ----------
MYSQL_HOST=mysql
MYSQL_DATABASE=geo_hazard_monitor
MYSQL_USER=root
MYSQL_PASSWORD=yourStrongPassword123

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=yourRedisPassword

# ---------- JWT ----------
# 生成方式：openssl rand -base64 32
JWT_SECRET=pleaseGenerateARealSecretHereUseOpensslRandBase64

# ---------- MQTT ----------
MQTT_USERNAME=mica
MQTT_PASSWORD=mica

# ---------- 可选 ----------
NGINX_PORT=80
# 根据实际情况修改！
JAVA_OPTS=-Xmx1024m -Xms512m -Djava.awt.headless=true -Dfork=true -Duser.timezone=Asia/Shanghai
# SPRING_PROFILES_ACTIVE=prod