<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.module.iot.rule.mapper.IotRuleMapper">

    <resultMap type="com.zwei.module.iot.rule.domain.IotRule" id="IotRuleResult">
        <result property="ruleId" column="rule_id"/>
        <result property="ruleName" column="rule_name"/>
        <result property="productKey" column="product_key"/>
        <result property="deviceKey" column="device_key"/>
        <result property="triggerType" column="trigger_type"/>
        <result property="ruleExpression" column="rule_expression"/>
        <result property="status" column="status"/>
        <result property="priority" column="priority"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <resultMap type="com.zwei.module.iot.rule.domain.IotRuleAction" id="IotRuleActionResult">
        <result property="actionId" column="action_id"/>
        <result property="ruleId" column="rule_id"/>
        <result property="actionType" column="action_type"/>
        <result property="actionParams" column="action_params"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap type="com.zwei.module.iot.rule.domain.IotRule" id="IotRuleWithActionResult" extends="IotRuleResult">
        <collection property="actionList" javaType="java.util.List"
                    resultMap="IotRuleActionResult" columnPrefix="sub_"/>
    </resultMap>

    <sql id="selectIotRuleVo">
        select rule_id,
               rule_name,
               product_key,
               device_key,
               trigger_type,
               rule_expression,
               status,
               priority,
               create_by,
               create_time,
               update_by,
               update_time,
               remark
        from zw_iot_rule
    </sql>

    <select id="selectIotRuleList" parameterType="com.zwei.module.iot.rule.domain.IotRule" resultMap="IotRuleResult">
        <include refid="selectIotRuleVo"/>
        <where>
            <if test="ruleName != null  and ruleName != ''">and rule_name like concat('%', #{ruleName}, '%')</if>
            <if test="productKey != null  and productKey != ''">and product_key = #{productKey}</if>
            <if test="status != null  and status != ''">and status = #{status}</if>
        </where>
    </select>

    <select id="selectIotRuleByRuleId" parameterType="Long" resultMap="IotRuleResult">
        <include refid="selectIotRuleVo"/>
        where rule_id = #{ruleId}
    </select>

    <select id="selectActiveRulesByProductKey" parameterType="String" resultMap="IotRuleWithActionResult">
        select a.rule_id,
               a.rule_name,
               a.product_key,
               a.device_key,
               a.trigger_type,
               a.rule_expression,
               a.status,
               a.priority,
               b.action_id     as sub_action_id,
               b.rule_id       as sub_rule_id,
               b.action_type   as sub_action_type,
               b.action_params as sub_action_params
        from zw_iot_rule a
                 left join zw_iot_rule_action b on b.rule_id = a.rule_id
        where a.product_key = #{productKey}
          and a.status = '1'
        order by a.priority desc
    </select>

    <insert id="insertIotRule" parameterType="com.zwei.module.iot.rule.domain.IotRule" useGeneratedKeys="true"
            keyProperty="ruleId">
        insert into zw_iot_rule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ruleName != null and ruleName != ''">rule_name,</if>
            <if test="productKey != null">product_key,</if>
            <if test="deviceKey != null">device_key,</if>
            <if test="triggerType != null">trigger_type,</if>
            <if test="ruleExpression != null">rule_expression,</if>
            <if test="status != null">status,</if>
            <if test="priority != null">priority,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ruleName != null and ruleName != ''">#{ruleName},</if>
            <if test="productKey != null">#{productKey},</if>
            <if test="deviceKey != null">#{deviceKey},</if>
            <if test="triggerType != null">#{triggerType},</if>
            <if test="ruleExpression != null">#{ruleExpression},</if>
            <if test="status != null">#{status},</if>
            <if test="priority != null">#{priority},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateIotRule" parameterType="com.zwei.module.iot.rule.domain.IotRule">
        update zw_iot_rule
        <trim prefix="SET" suffixOverrides=",">
            <if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
            <if test="productKey != null">product_key = #{productKey},</if>
            <if test="deviceKey != null">device_key = #{deviceKey},</if>
            <if test="triggerType != null">trigger_type = #{triggerType},</if>
            <if test="ruleExpression != null">rule_expression = #{ruleExpression},</if>
            <if test="status != null">status = #{status},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteIotRuleByRuleId" parameterType="Long">
        delete
        from zw_iot_rule
        where rule_id = #{ruleId}
    </delete>

    <delete id="deleteIotRuleByRuleIds" parameterType="String">
        delete from zw_iot_rule where rule_id in
        <foreach item="ruleId" collection="array" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>

    <delete id="deleteIotRuleActionByRuleId" parameterType="Long">
        delete
        from zw_iot_rule_action
        where rule_id = #{ruleId}
    </delete>

    <insert id="batchInsertIotRuleAction">
        insert into zw_iot_rule_action(rule_id, action_type, action_params, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#{item.ruleId}, #{item.actionType}, #{item.actionParams}, sysdate())
        </foreach>
    </insert>

    <select id="selectRuleActionsByRuleId" parameterType="Long" resultMap="IotRuleActionResult">
        select action_id, rule_id, action_type, action_params, create_time
        from zw_iot_rule_action
        where rule_id = #{ruleId}
    </select>

</mapper>
