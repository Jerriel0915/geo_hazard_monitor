<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.mapper.DeviceMapper">

    <!-- ==================== 结果映射 ==================== -->
    <resultMap type="com.zwei.iot.domain.Device" id="DeviceResult">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="icon" column="icon"/>
        <result property="iconPath" column="icon_path"/>
        <result property="status" column="status"/>
        <result property="runStatus" column="run_status"/>
        <result property="lastReportTime" column="last_report_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ==================== SQL片段 ==================== -->
    <sql id="selectDeviceVo">
        SELECT d.id,
               d.code,
               d.name,
               d.icon,
               d.icon_path,
               d.status,
               d.run_status,
               d.last_report_time,
               d.del_flag,
               d.create_by,
               d.create_time,
               d.update_by,
               d.update_time,
               CASE d.status
                   WHEN 1 THEN '正常'
                   WHEN 2 THEN '故障'
                   WHEN 3 THEN '离线'
                   ELSE '未知'
                   END AS statusName,
               CASE d.run_status
                   WHEN 0 THEN '未知'
                   WHEN 1 THEN '运行中'
                   WHEN 2 THEN '停止'
                   ELSE '未知'
                   END AS runStatusName
        FROM device d
    </sql>

    <!-- ==================== 查询操作 ==================== -->

    <!-- 分页查询设备列表 -->
    <select id="selectDeviceList" parameterType="com.zwei.iot.domain.Device" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        <where>
            d.del_flag = 0
            <if test="code != null and code != ''">
                AND d.code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="name != null and name != ''">
                AND d.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="status != null">
                AND d.status = #{status}
            </if>
        </where>
        ORDER BY d.id DESC
    </select>

    <!-- 查询所有设备列表 -->
    <select id="selectDeviceAll" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.del_flag = 0
        ORDER BY d.id DESC
    </select>

    <!-- 根据ID查询设备详情 -->
    <select id="selectDeviceById" parameterType="Long" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.id = #{id} AND d.del_flag = 0
    </select>

    <!-- 根据编码查询设备 -->
    <select id="selectDeviceByCode" parameterType="String" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.code = #{code} AND d.del_flag = 0
    </select>

    <!-- 校验设备编码是否唯一 -->
    <select id="checkDeviceCodeUnique" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.code = #{code} AND d.del_flag = 0 AND d.id != #{id} LIMIT 1
    </select>

    <!-- ==================== 新增操作 ==================== -->

    <!-- 新增设备 -->
    <insert id="insertDevice" parameterType="com.zwei.iot.domain.Device" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO device(
        <if test="code != null and code != ''">code,</if>
        <if test="name != null and name != ''">name,</if>
        <if test="icon != null">icon,</if>
        <if test="iconPath != null">icon_path,</if>
        <if test="status != null">status,</if>
        <if test="createBy != null and createBy != ''">create_by,</if>
        create_time
        ) VALUES (
        <if test="code != null and code != ''">#{code},</if>
        <if test="name != null and name != ''">#{name},</if>
        <if test="icon != null">#{icon},</if>
        <if test="iconPath != null">#{iconPath},</if>
        <if test="status != null">#{status},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        SYSDATE()
        )
    </insert>

    <!-- ==================== 修改操作 ==================== -->

    <!-- 修改设备 -->
    <update id="updateDevice" parameterType="com.zwei.iot.domain.Device">
        UPDATE device
        <set>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="iconPath != null">icon_path = #{iconPath},</if>
            <if test="status != null">status = #{status},</if>
            <if test="runStatus != null">run_status = #{runStatus},</if>
            <if test="lastReportTime != null">last_report_time = #{lastReportTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = SYSDATE()
        </set>
        WHERE id = #{id}
    </update>

    <!-- ==================== 删除操作 ==================== -->

    <!-- 删除设备（逻辑删除） -->
    <delete id="deleteDeviceById" parameterType="Long">
        UPDATE device
        SET del_flag = 1
        WHERE id = #{id}
    </delete>

    <!-- 批量删除设备（逻辑删除） -->
    <delete id="deleteDeviceByIds" parameterType="Long">
        UPDATE device SET del_flag = 1
        WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>