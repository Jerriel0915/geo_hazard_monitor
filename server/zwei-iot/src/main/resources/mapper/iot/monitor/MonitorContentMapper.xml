<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.monitor.mapper.MonitorContentMapper">

    <!-- ==================== 结果映射 ==================== -->
    <resultMap type="com.zwei.iot.monitor.domain.MonitorContent" id="MonitorContentResult">
        <id property="id" column="id"/>
        <result property="monitorTypeId" column="monitor_type_id"/>
        <result property="monitorTypeName" column="monitor_type_name"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="unit" column="unit"/>
        <result property="indicatorType" column="indicator_type"/>
        <result property="icon" column="icon"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ==================== SQL片段 ==================== -->
    <sql id="selectMonitorContentVo">
        SELECT mc.id,
               mc.monitor_type_id,
               mc.code,
               mc.name,
               mc.unit,
               mc.indicator_type,
               mc.icon,
               mc.create_by,
               mc.create_time,
               mc.update_by,
               mc.update_time,
               mt.name AS monitor_type_name
        FROM monitor_content mc
                 LEFT JOIN monitor_type mt ON mc.monitor_type_id = mt.id
    </sql>

    <!-- ==================== 查询操作 ==================== -->

    <!-- 查询监测内容列表 -->
    <select id="selectMonitorContentList" parameterType="com.zwei.iot.monitor.domain.MonitorContent"
            resultMap="MonitorContentResult">
        <include refid="selectMonitorContentVo"/>
        <where>
            mc.del_flag = 0
            <if test="monitorTypeId != null">
                AND mc.monitor_type_id = #{monitorTypeId}
            </if>
            <if test="code != null and code != ''">
                AND mc.code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="name != null and name != ''">
                AND mc.name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY mc.id ASC
    </select>

    <!-- 查询所有监测内容列表（不分页） -->
    <select id="selectMonitorContentAll" resultMap="MonitorContentResult">
        <include refid="selectMonitorContentVo"/>
        WHERE mc.del_flag = 0
        <if test="monitorTypeId != null">
            AND mc.monitor_type_id = #{monitorTypeId}
        </if>
        ORDER BY mc.id ASC
    </select>

    <!-- 根据ID查询监测内容详情 -->
    <select id="selectMonitorContentById" parameterType="Long" resultMap="MonitorContentResult">
        <include refid="selectMonitorContentVo"/>
        WHERE mc.id = #{id} AND mc.del_flag = 0
    </select>

    <!-- 根据编码查询监测内容 -->
    <select id="selectMonitorContentByCode" parameterType="String" resultMap="MonitorContentResult">
        <include refid="selectMonitorContentVo"/>
        WHERE mc.code = #{code} AND mc.del_flag = 0
    </select>

    <!-- 校验监测内容编码是否唯一 -->
    <select id="checkMonitorContentCodeUnique" resultMap="MonitorContentResult">
        <include refid="selectMonitorContentVo"/>
        WHERE mc.code = #{code} AND mc.del_flag = 0 AND mc.id != #{id} LIMIT 1
    </select>

    <!-- ==================== 新增操作 ==================== -->

    <!-- 新增监测内容 -->
    <insert id="insertMonitorContent" parameterType="com.zwei.iot.monitor.domain.MonitorContent" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO monitor_content(
        <if test="monitorTypeId != null">monitor_type_id,</if>
        <if test="code != null and code != ''">code,</if>
        <if test="name != null and name != ''">name,</if>
        <if test="unit != null">unit,</if>
        <if test="indicatorType != null">indicator_type,</if>
        <if test="icon != null">icon,</if>
        <if test="createBy != null and createBy != ''">create_by,</if>
        create_time
        ) VALUES (
        <if test="monitorTypeId != null">#{monitorTypeId},</if>
        <if test="code != null and code != ''">#{code},</if>
        <if test="name != null and name != ''">#{name},</if>
        <if test="unit != null">#{unit},</if>
        <if test="indicatorType != null">#{indicatorType},</if>
        <if test="icon != null">#{icon},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        SYSDATE()
        )
    </insert>

    <!-- ==================== 修改操作 ==================== -->

    <!-- 修改监测内容 -->
    <update id="updateMonitorContent" parameterType="com.zwei.iot.monitor.domain.MonitorContent">
        UPDATE monitor_content
        <set>
            <if test="monitorTypeId != null">monitor_type_id = #{monitorTypeId},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="indicatorType != null">indicator_type = #{indicatorType},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = SYSDATE()
        </set>
        WHERE id = #{id}
    </update>

    <!-- ==================== 删除操作 ==================== -->

    <!-- 删除监测内容（逻辑删除） -->
    <delete id="deleteMonitorContentById" parameterType="Long">
        UPDATE monitor_content
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE id = #{id}
          AND del_flag = 0
    </delete>

    <!-- 批量删除监测内容（逻辑删除） -->
    <delete id="deleteMonitorContentByIds" parameterType="Long">
        UPDATE monitor_content
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE del_flag = 0
          AND id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
