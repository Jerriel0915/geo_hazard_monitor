<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.mapper.HazardPointMapper">

    <resultMap type="HazardPoint" id="HazardPointResult">
        <id     property="id"           column="id"           />
        <result property="code"         column="code"         />
        <result property="name"         column="name"         />
        <result property="groupId"      column="group_id"     />
        <result property="groupName"    column="group_name"   />
        <result property="status"       column="status"       />
        <result property="longitude"    column="longitude"    />
        <result property="latitude"     column="latitude"     />
        <result property="altitude"     column="altitude"     />
        <result property="location"     column="location"     />
        <result property="address"      column="address"      />
        <result property="boundary"     column="boundary"     />
        <result property="strike"       column="strike"       />
        <result property="strikeArrow"  column="strike_arrow" />
        <result property="description"  column="description"  />
        <result property="riskLevel"    column="risk_level"   />
        <result property="delFlag"      column="del_flag"     />
        <result property="createBy"     column="create_by"    />
        <result property="createTime"   column="create_time"  />
        <result property="updateBy"     column="update_by"    />
        <result property="updateTime"   column="update_time"  />
    </resultMap>

    <sql id="selectHazardPointVo">
        select id, code, name, group_id, group_name, status, longitude, latitude, 
               altitude, location, address, boundary, strike, strike_arrow, 
               description, risk_level, del_flag, create_by, create_time, update_by, update_time
        from hazard_point
    </sql>

    <select id="selectHazardPointList" parameterType="HazardPoint" resultMap="HazardPointResult">
        <include refid="selectHazardPointVo"/>
        <where>
            del_flag = 0
            <if test="code != null and code != ''">AND code like concat('%', #{code}, '%')</if>
            <if test="name != null and name != ''">AND name like concat('%', #{name}, '%')</if>
            <if test="groupId != null">AND group_id = #{groupId}</if>
            <if test="status != null">AND status = #{status}</if>
            <if test="riskLevel != null">AND risk_level = #{riskLevel}</if>
        </where>
        order by id desc
    </select>

    <select id="selectHazardPointById" parameterType="Long" resultMap="HazardPointResult">
        <include refid="selectHazardPointVo"/>
        where id = #{id} and del_flag = 0
    </select>

    <select id="selectHazardPointByCode" parameterType="String" resultMap="HazardPointResult">
        <include refid="selectHazardPointVo"/>
        where code = #{code} and del_flag = 0
    </select>

    <select id="checkHazardPointCodeUnique" parameterType="String" resultMap="HazardPointResult">
        <include refid="selectHazardPointVo"/>
        where code = #{code} and del_flag = 0 limit 1
    </select>

    <insert id="insertHazardPoint" parameterType="HazardPoint" useGeneratedKeys="true" keyProperty="id">
        insert into hazard_point(
            <if test="code != null and code != ''">code,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="groupId != null">group_id,</if>
            <if test="groupName != null">group_name,</if>
            <if test="status != null">status,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
            <if test="altitude != null">altitude,</if>
            <if test="location != null">location,</if>
            <if test="address != null">address,</if>
            <if test="boundary != null">boundary,</if>
            <if test="strike != null">strike,</if>
            <if test="strikeArrow != null">strike_arrow,</if>
            <if test="description != null">description,</if>
            <if test="riskLevel != null">risk_level,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="code != null and code != ''">#{code},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="groupId != null">#{groupId},</if>
            <if test="groupName != null">#{groupName},</if>
            <if test="status != null">#{status},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="altitude != null">#{altitude},</if>
            <if test="location != null">#{location},</if>
            <if test="address != null">#{address},</if>
            <if test="boundary != null">#{boundary},</if>
            <if test="strike != null">#{strike},</if>
            <if test="strikeArrow != null">#{strikeArrow},</if>
            <if test="description != null">#{description},</if>
            <if test="riskLevel != null">#{riskLevel},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateHazardPoint" parameterType="HazardPoint">
        update hazard_point
        <set>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="groupId != null">group_id = #{groupId},</if>
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="altitude != null">altitude = #{altitude},</if>
            <if test="location != null">location = #{location},</if>
            <if test="address != null">address = #{address},</if>
            <if test="boundary != null">boundary = #{boundary},</if>
            <if test="strike != null">strike = #{strike},</if>
            <if test="strikeArrow != null">strike_arrow = #{strikeArrow},</if>
            <if test="description != null">description = #{description},</if>
            <if test="riskLevel != null">risk_level = #{riskLevel},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="deleteHazardPointById" parameterType="Long">
        update hazard_point set del_flag = 1 where id = #{id}
    </update>

    <update id="deleteHazardPointByIds" parameterType="Long">
        update hazard_point set del_flag = 1 where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>

    <update id="updateHazardPointPause" parameterType="Map">
        update hazard_point set status = #{status}, update_time = sysdate() where id = #{id}
    </update>

    <update id="completeHazardPoint" parameterType="Long">
        update hazard_point set status = 3, update_time = sysdate() where id = #{id}
    </update>

    <update id="batchUpdateStatus" parameterType="Map">
        update hazard_point set status = #{status}, update_time = sysdate() where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>

</mapper>