<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.mapper.HazardPointGroupMapper">

    <resultMap type="HazardPointGroup" id="HazardPointGroupResult">
        <id     property="id"           column="id"           />
        <result property="code"         column="code"         />
        <result property="name"         column="name"         />
        <result property="description"  column="description"  />
        <result property="sortOrder"    column="sort_order"   />
        <result property="status"       column="status"       />
        <result property="delFlag"      column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"     column="update_by"    />
        <result property="updateTime"   column="update_time"  />
    </resultMap>

    <sql id="selectHazardPointGroupVo">
        select id, code, name, description, sort_order, status, del_flag, create_by, create_time, update_by, update_time
        from hazard_point_group
    </sql>

    <select id="selectHazardPointGroupList" parameterType="HazardPointGroup" resultMap="HazardPointGroupResult">
        <include refid="selectHazardPointGroupVo"/>
        <where>
            del_flag = 0
            <if test="code != null and code != ''">AND code like concat('%', #{code}, '%')</if>
            <if test="name != null and name != ''">AND name like concat('%', #{name}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        order by sort_order asc, id asc
    </select>

    <select id="selectHazardPointGroupAll" resultMap="HazardPointGroupResult">
        <include refid="selectHazardPointGroupVo"/>
        where del_flag = 0
        order by sort_order asc, id asc
    </select>

    <select id="selectHazardPointGroupById" parameterType="Long" resultMap="HazardPointGroupResult">
        <include refid="selectHazardPointGroupVo"/>
        where id = #{id}
    </select>

    <select id="selectHazardPointGroupByCode" parameterType="String" resultMap="HazardPointGroupResult">
        <include refid="selectHazardPointGroupVo"/>
        where code = #{code} and del_flag = 0
    </select>

    <select id="checkGroupCodeUnique" parameterType="String" resultMap="HazardPointGroupResult">
        <include refid="selectHazardPointGroupVo"/>
        where code = #{code} and del_flag = 0 limit 1
    </select>

    <select id="countHazardPointsByGroupIds" resultType="java.util.Map">
        select group_id as groupId, count(*) as cnt
        from hazard_point
        where del_flag = 0 and group_id in
        <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
        group by group_id
    </select>

    <insert id="insertHazardPointGroup" parameterType="HazardPointGroup" useGeneratedKeys="true" keyProperty="id">
        insert into hazard_point_group(
            <if test="code != null and code != ''">code,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="description != null">description,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="code != null and code != ''">#{code},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="description != null">#{description},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateHazardPointGroup" parameterType="HazardPointGroup">
        update hazard_point_group
        <set>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteHazardPointGroupById" parameterType="Long">
        update hazard_point_group set del_flag = 1 where id = #{id}
    </delete>

    <delete id="deleteHazardPointGroupByIds" parameterType="Long">
        update hazard_point_group set del_flag = 1 where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
