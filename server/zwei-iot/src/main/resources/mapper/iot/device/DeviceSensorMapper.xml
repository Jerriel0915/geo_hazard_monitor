<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.device.mapper.DeviceSensorMapper">

    <!-- ==================== 结果映射 ==================== -->
    <resultMap type="com.zwei.iot.device.domain.DeviceSensor" id="DeviceSensorResult">
        <id property="id" column="id"/>
        <result property="deviceId" column="device_id"/>
        <result property="deviceCode" column="device_code"/>
        <result property="sensorCode" column="sensor_code"/>
        <result property="sensorNo" column="sensor_no"/>
        <result property="sensorName" column="sensor_name"/>
        <result property="monitorTypeId" column="monitor_type_id"/>
        <result property="monitorTypeCode" column="monitor_type_code"/>
        <result property="monitorTypeName" column="monitor_type_name"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ==================== SQL片段 ==================== -->
    <sql id="selectSensorVo">
        SELECT ds.id,
               ds.device_id,
               ds.device_code,
               ds.sensor_code,
               ds.sensor_no,
               ds.sensor_name,
               ds.monitor_type_id,
               ds.monitor_type_code,
               ds.monitor_type_name,
               ds.status,
               ds.del_flag,
               ds.create_by,
               ds.create_time,
               ds.update_by,
               ds.update_time
        FROM device_sensor ds
    </sql>

    <!-- ==================== 查询操作 ==================== -->

    <!-- 查询设备下的传感器列表 -->
    <select id="selectSensorListByDeviceId" parameterType="Long" resultMap="DeviceSensorResult">
        <include refid="selectSensorVo"/>
        WHERE ds.device_id = #{deviceId} AND ds.del_flag = 0
        ORDER BY ds.id ASC
    </select>

    <!-- 根据ID查询传感器详情 -->
    <select id="selectSensorById" parameterType="Long" resultMap="DeviceSensorResult">
        <include refid="selectSensorVo"/>
        WHERE ds.id = #{id} AND ds.del_flag = 0
    </select>

    <!-- 根据编码查询传感器 -->
    <select id="selectSensorByCode" parameterType="String" resultMap="DeviceSensorResult">
        <include refid="selectSensorVo"/>
        WHERE ds.sensor_code = #{sensorCode} AND ds.del_flag = 0
    </select>

    <!-- 校验传感器编码是否唯一 -->
    <select id="checkSensorCodeUnique" resultMap="DeviceSensorResult">
        <include refid="selectSensorVo"/>
        WHERE ds.sensor_code = #{sensorCode} AND ds.del_flag = 0 AND ds.id != #{id} LIMIT 1
    </select>

    <!-- ==================== 新增操作 ==================== -->

    <!-- 新增传感器 -->
    <insert id="insertSensor" parameterType="com.zwei.iot.device.domain.DeviceSensor" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO device_sensor(
        <if test="deviceId != null">device_id,</if>
        <if test="deviceCode != null">device_code,</if>
        <if test="sensorCode != null and sensorCode != ''">sensor_code,</if>
        <if test="sensorNo != null and sensorNo != ''">sensor_no,</if>
        <if test="sensorName != null and sensorName != ''">sensor_name,</if>
        <if test="monitorTypeId != null">monitor_type_id,</if>
        <if test="monitorTypeCode != null">monitor_type_code,</if>
        <if test="monitorTypeName != null">monitor_type_name,</if>
        <if test="status != null">status,</if>
        <if test="createBy != null and createBy != ''">create_by,</if>
        create_time
        ) VALUES (
        <if test="deviceId != null">#{deviceId},</if>
        <if test="deviceCode != null">#{deviceCode},</if>
        <if test="sensorCode != null and sensorCode != ''">#{sensorCode},</if>
        <if test="sensorNo != null and sensorNo != ''">#{sensorNo},</if>
        <if test="sensorName != null and sensorName != ''">#{sensorName},</if>
        <if test="monitorTypeId != null">#{monitorTypeId},</if>
        <if test="monitorTypeCode != null">#{monitorTypeCode},</if>
        <if test="monitorTypeName != null">#{monitorTypeName},</if>
        <if test="status != null">#{status},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        SYSDATE()
        )
    </insert>

    <!-- ==================== 修改操作 ==================== -->

    <!-- 修改传感器 -->
    <update id="updateSensor" parameterType="com.zwei.iot.device.domain.DeviceSensor">
        UPDATE device_sensor
        <set>
            <if test="deviceCode != null and deviceCode != ''">device_code = #{deviceCode},</if>
            <if test="sensorNo != null and sensorNo != ''">sensor_no = #{sensorNo},</if>
            <if test="sensorName != null and sensorName != ''">sensor_name = #{sensorName},</if>
            <if test="monitorTypeId != null">monitor_type_id = #{monitorTypeId},</if>
            <if test="monitorTypeCode != null">monitor_type_code = #{monitorTypeCode},</if>
            <if test="monitorTypeName != null">monitor_type_name = #{monitorTypeName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = SYSDATE()
        </set>
        WHERE id = #{id}
          AND del_flag = 0
    </update>

    <!-- ==================== 删除操作 ==================== -->

    <!-- 删除传感器（逻辑删除） -->
    <delete id="deleteSensorById" parameterType="Long">
        UPDATE device_sensor
        SET sensor_code = CONCAT(LEFT(sensor_code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE id = #{id}
          AND del_flag = 0
    </delete>

    <!-- 根据设备ID删除传感器（逻辑删除） -->
    <delete id="deleteSensorByDeviceId" parameterType="Long">
        UPDATE device_sensor
        SET sensor_code = CONCAT(LEFT(sensor_code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE device_id = #{deviceId}
          AND del_flag = 0
    </delete>

    <!-- 根据传感器条件查询传感器列表 -->
    <select id="selectSensorList" parameterType="com.zwei.iot.device.domain.DeviceSensor" resultMap="DeviceSensorResult">
        <include refid="selectSensorVo"/>
        <where>
            <if test="deviceId != null">ds.device_id = #{deviceId}</if>
            <if test="deviceCode != null and deviceCode != ''">AND ds.device_code = #{deviceCode}</if>
            <if test="sensorCode != null and sensorCode != ''">AND ds.sensor_code = #{sensorCode}</if>
            <!-- MQTT 鉴权中心按 topic 中的 sensor_no 做发布权限校验，因此这里补充 sensor_no 过滤。 -->
            <if test="sensorNo != null and sensorNo != ''">AND ds.sensor_no = #{sensorNo}</if>
            <if test="sensorName != null and sensorName != ''">AND ds.sensor_name LIKE CONCAT('%', #{sensorName}, '%')</if>
            <if test="monitorTypeId != null">AND ds.monitor_type_id = #{monitorTypeId}</if>
            <if test="monitorTypeCode != null and monitorTypeCode != ''">AND ds.monitor_type_code = #{monitorTypeCode}</if>
            <if test="status != null">AND ds.status = #{status}</if>
            AND ds.del_flag = 0
        </where>
        ORDER BY ds.id ASC
    </select>

    <!-- ==================== 统计查询 ==================== -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM device_sensor
        WHERE del_flag = 0
    </select>

    <select id="countByStatus" resultType="java.util.Map">
        SELECT status, COUNT(*) AS cnt
        FROM device_sensor
        WHERE del_flag = 0
        GROUP BY status
    </select>

    <select id="countByMonitorType" resultType="java.util.Map">
        SELECT ds.monitor_type_id AS monitorTypeId, mt.name AS monitorTypeName, COUNT(*) AS cnt
        FROM device_sensor ds
                 INNER JOIN monitor_type mt ON ds.monitor_type_id = mt.id AND mt.del_flag = 0
        WHERE ds.del_flag = 0
        GROUP BY ds.monitor_type_id, mt.name
    </select>

</mapper>
