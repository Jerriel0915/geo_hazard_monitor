<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.device.mapper.DeviceMapper">

    <!-- ==================== 结果映射 ==================== -->
    <resultMap type="com.zwei.iot.device.domain.Device" id="DeviceResult">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="sn" column="sn"/>
        <result property="deviceType" column="device_type"/>
        <result property="networkType" column="network_type"/>
        <result property="protocolType" column="protocol_type"/>
        <result property="registerSource" column="register_source"/>
        <result property="vendorName" column="vendor_name"/>
        <result property="authUsername" column="auth_username"/>
        <result property="authPassword" column="auth_password"/>
        <result property="authStatus" column="auth_status"/>
        <result property="icon" column="icon"/>
        <result property="iconPath" column="icon_path"/>
        <result property="status" column="status"/>
        <result property="runStatus" column="run_status"/>
        <result property="lastReportTime" column="last_report_time"/>
        <result property="registeredAt" column="registered_at"/>
        <result property="lastAuthTime" column="last_auth_time"/>
        <result property="lastAuthIp" column="last_auth_ip"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ==================== SQL片段 ==================== -->
    <sql id="selectDeviceVo">
        SELECT d.id,
               d.code,
               d.name,
               d.sn,
               d.device_type,
               d.network_type,
               d.protocol_type,
               d.register_source,
               d.vendor_name,
               d.auth_username,
               d.auth_password,
               d.auth_status,
               d.icon,
               d.icon_path,
               d.status,
               d.run_status,
               d.last_report_time,
               d.registered_at,
               d.last_auth_time,
               d.last_auth_ip,
               d.del_flag,
               d.create_by,
               d.create_time,
               d.update_by,
               d.update_time,
               CASE d.status
                   WHEN 1 THEN '正常'
                   WHEN 2 THEN '故障'
                   WHEN 3 THEN '离线'
                   ELSE '未知'
                   END AS statusName,
               CASE d.run_status
                   WHEN 0 THEN '未知'
                   WHEN 1 THEN '运行中'
                   WHEN 2 THEN '停止'
                   ELSE '未知'
                   END AS runStatusName
        FROM device d
    </sql>

    <!-- ==================== 查询操作 ==================== -->

    <!-- 分页查询设备列表 -->
    <select id="selectDeviceList" parameterType="com.zwei.iot.device.domain.Device" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        <where>
            d.del_flag = 0
            <if test="code != null and code != ''">
                AND d.code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="name != null and name != ''">
                AND d.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="sn != null and sn != ''">
                AND d.sn LIKE CONCAT('%', #{sn}, '%')
            </if>
            <if test="status != null">
                AND d.status = #{status}
            </if>
            <if test="runStatus != null">
                AND d.run_status = #{runStatus}
            </if>
        </where>
        ORDER BY d.id DESC
    </select>

    <!-- 查询所有设备列表 -->
    <select id="selectDeviceAll" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.del_flag = 0
        ORDER BY d.id DESC
    </select>

    <!-- 根据ID查询设备详情 -->
    <select id="selectDeviceById" parameterType="Long" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.id = #{id} AND d.del_flag = 0
    </select>

    <!-- 根据ID列表批量查询设备 -->
    <select id="selectDeviceByIds" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND d.del_flag = 0
    </select>

    <!-- 根据编码查询设备 -->
    <select id="selectDeviceByCode" parameterType="String" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.code = #{code} AND d.del_flag = 0
    </select>

    <select id="selectDeviceBySn" parameterType="String" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.sn = #{sn} AND d.del_flag = 0
        LIMIT 1
    </select>

    <select id="selectDeviceByAuthUsername" parameterType="String" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        WHERE d.auth_username = #{authUsername} AND d.del_flag = 0
        LIMIT 1
    </select>

    <!-- 校验设备编码是否唯一 -->
    <select id="checkDeviceCodeUnique" resultMap="DeviceResult">
        <include refid="selectDeviceVo"/>
        <where>
            <if test="code != null and code != ''">d.code = #{code}</if>
            <if test="code != null and code != ''">AND d.del_flag = 0</if>
            <if test="id != null">AND d.id != #{id}</if>
        </where>
        LIMIT 1
    </select>

    <!-- ==================== 新增操作 ==================== -->

    <!-- 新增设备 -->
    <insert id="insertDevice" parameterType="com.zwei.iot.device.domain.Device" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO device(
        <if test="code != null and code != ''">code,</if>
        <if test="name != null and name != ''">name,</if>
        <if test="sn != null and sn != ''">sn,</if>
        <if test="deviceType != null">device_type,</if>
        <if test="networkType != null">network_type,</if>
        <if test="protocolType != null and protocolType != ''">protocol_type,</if>
        <if test="registerSource != null and registerSource != ''">register_source,</if>
        <if test="vendorName != null and vendorName != ''">vendor_name,</if>
        <if test="authUsername != null and authUsername != ''">auth_username,</if>
        <if test="authPassword != null and authPassword != ''">auth_password,</if>
        <if test="authStatus != null">auth_status,</if>
        <if test="icon != null">icon,</if>
        <if test="iconPath != null">icon_path,</if>
        <if test="status != null">status,</if>
        <if test="registeredAt != null and registeredAt != ''">registered_at,</if>
        <if test="lastAuthTime != null and lastAuthTime != ''">last_auth_time,</if>
        <if test="lastAuthIp != null and lastAuthIp != ''">last_auth_ip,</if>
        <if test="createBy != null and createBy != ''">create_by,</if>
        create_time
        ) VALUES (
        <if test="code != null and code != ''">#{code},</if>
        <if test="name != null and name != ''">#{name},</if>
        <if test="sn != null and sn != ''">#{sn},</if>
        <if test="deviceType != null">#{deviceType},</if>
        <if test="networkType != null">#{networkType},</if>
        <if test="protocolType != null and protocolType != ''">#{protocolType},</if>
        <if test="registerSource != null and registerSource != ''">#{registerSource},</if>
        <if test="vendorName != null and vendorName != ''">#{vendorName},</if>
        <if test="authUsername != null and authUsername != ''">#{authUsername},</if>
        <if test="authPassword != null and authPassword != ''">#{authPassword},</if>
        <if test="authStatus != null">#{authStatus},</if>
        <if test="icon != null">#{icon},</if>
        <if test="iconPath != null">#{iconPath},</if>
        <if test="status != null">#{status},</if>
        <if test="registeredAt != null and registeredAt != ''">#{registeredAt},</if>
        <if test="lastAuthTime != null and lastAuthTime != ''">#{lastAuthTime},</if>
        <if test="lastAuthIp != null and lastAuthIp != ''">#{lastAuthIp},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        SYSDATE()
        )
    </insert>

    <!-- ==================== 修改操作 ==================== -->

    <!-- 修改设备 -->
    <update id="updateDevice" parameterType="com.zwei.iot.device.domain.Device">
        UPDATE device
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="sn != null">sn = #{sn},</if>
            <if test="deviceType != null">device_type = #{deviceType},</if>
            <if test="networkType != null">network_type = #{networkType},</if>
            <if test="protocolType != null and protocolType != ''">protocol_type = #{protocolType},</if>
            <if test="registerSource != null and registerSource != ''">register_source = #{registerSource},</if>
            <if test="vendorName != null">vendor_name = #{vendorName},</if>
            <if test="authUsername != null">auth_username = #{authUsername},</if>
            <if test="authPassword != null">auth_password = #{authPassword},</if>
            <if test="authStatus != null">auth_status = #{authStatus},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="iconPath != null">icon_path = #{iconPath},</if>
            <if test="status != null">status = #{status},</if>
            <if test="runStatus != null">run_status = #{runStatus},</if>
            <if test="lastReportTime != null">last_report_time = #{lastReportTime},</if>
            <if test="registeredAt != null">registered_at = #{registeredAt},</if>
            <if test="lastAuthTime != null">last_auth_time = #{lastAuthTime},</if>
            <if test="lastAuthIp != null">last_auth_ip = #{lastAuthIp},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = SYSDATE()
        </set>
        WHERE id = #{id}
    </update>

    <!-- ==================== 删除操作 ==================== -->

    <!-- 删除设备（逻辑删除） -->
    <delete id="deleteDeviceById" parameterType="Long">
        UPDATE device
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            auth_username = NULL,
            auth_password = NULL,
            del_flag = 1,
            update_time = SYSDATE()
        WHERE id = #{id}
          AND del_flag = 0
    </delete>

    <!-- 批量删除设备（逻辑删除） -->
    <delete id="deleteDeviceByIds" parameterType="Long">
        UPDATE device
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            auth_username = NULL,
            auth_password = NULL,
            del_flag = 1,
            update_time = SYSDATE()
        WHERE del_flag = 0
          AND id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- ==================== 统计查询 ==================== -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM device
        WHERE del_flag = 0
    </select>

    <select id="countByStatus" resultType="java.util.Map">
        SELECT status, COUNT(*) AS cnt
        FROM device
        WHERE del_flag = 0
        GROUP BY status
    </select>

    <select id="countByRunStatus" resultType="java.util.Map">
        SELECT run_status AS runStatus, COUNT(*) AS cnt
        FROM device
        WHERE del_flag = 0
        GROUP BY run_status
    </select>

    <select id="countByMonitorType" resultType="java.util.Map">
        SELECT ds.monitor_type_id AS monitorTypeId, mt.name AS monitorTypeName, COUNT(DISTINCT d.id) AS cnt
        FROM device d
                 INNER JOIN device_sensor ds ON d.id = ds.device_id AND ds.del_flag = 0
                 INNER JOIN monitor_type mt ON ds.monitor_type_id = mt.id AND mt.del_flag = 0
        WHERE d.del_flag = 0
        GROUP BY ds.monitor_type_id, mt.name
    </select>

</mapper>
