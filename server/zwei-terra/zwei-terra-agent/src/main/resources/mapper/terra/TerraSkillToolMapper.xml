<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.terra.agent.mapper.TerraSkillToolMapper">

    <select id="selectBySkillId" parameterType="Long" resultType="java.util.Map">
        SELECT st.skill_id AS skillId,
               st.tool_id  AS toolId,
               t.tool_key  AS toolKey,
               t.name       AS toolName,
               t.exec_side  AS execSide
        FROM terra_skill_tool st
        INNER JOIN terra_tool t ON t.id = st.tool_id AND t.del_flag = '0'
        WHERE st.skill_id = #{skillId}
    </select>

    <insert id="insert">
        INSERT INTO terra_skill_tool (skill_id, tool_id)
        VALUES (#{skillId}, #{toolId})
    </insert>

    <delete id="deleteBySkillId" parameterType="Long">
        DELETE FROM terra_skill_tool
        WHERE skill_id = #{skillId}
    </delete>

</mapper>
