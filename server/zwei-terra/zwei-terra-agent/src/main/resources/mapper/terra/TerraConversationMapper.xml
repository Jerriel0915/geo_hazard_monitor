<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.terra.agent.mapper.TerraConversationMapper">

    <resultMap type="com.zwei.terra.agent.domain.TerraConversation" id="TerraConversationResult">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="status" column="status"/>
        <result property="lastMessageTime" column="last_message_time"/>
        <result property="messageCount" column="message_count"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVo">
        SELECT id, user_id, title, status, last_message_time, message_count,
               del_flag, create_by, create_time, update_by, update_time, remark
        FROM terra_conversation
    </sql>

    <select id="selectByUserId" parameterType="Long" resultMap="TerraConversationResult">
        <include refid="selectVo"/>
        WHERE user_id = #{userId} AND del_flag = '0'
        ORDER BY last_message_time DESC, id DESC
    </select>

    <select id="selectById" parameterType="Long" resultMap="TerraConversationResult">
        <include refid="selectVo"/>
        WHERE id = #{id} AND del_flag = '0'
    </select>

    <insert id="insert" parameterType="com.zwei.terra.agent.domain.TerraConversation"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO terra_conversation (user_id, title, status, last_message_time,
                                        message_count, del_flag, create_by, create_time, remark)
        VALUES (#{userId}, #{title}, #{status}, #{lastMessageTime},
                #{messageCount}, '0', #{createBy}, #{createTime}, #{remark})
    </insert>

    <update id="update" parameterType="com.zwei.terra.agent.domain.TerraConversation">
        UPDATE terra_conversation
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="lastMessageTime != null">last_message_time = #{lastMessageTime},</if>
            <if test="messageCount != null">message_count = #{messageCount},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_by = #{updateBy},
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <update id="deleteById" parameterType="Long">
        UPDATE terra_conversation
        SET del_flag = '1'
        WHERE id = #{id}
    </update>

</mapper>
