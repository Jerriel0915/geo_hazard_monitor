<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.datashare.mapper.ShareStrategyScriptMapper">

    <resultMap id="ShareStrategyScriptResultMap" type="com.zwei.datashare.domain.ShareStrategyScript">
        <id column="id" property="id"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="script" property="script"/>
        <result column="variables" property="variables"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.zwei.datashare.domain.ShareStrategyScript" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO share_strategy_script (strategy_id, script, variables, create_time, update_time)
        VALUES (#{strategyId}, #{script}, #{variables}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateById" parameterType="com.zwei.datashare.domain.ShareStrategyScript">
        UPDATE share_strategy_script SET
        <if test="strategyId != null">strategy_id = #{strategyId},</if>
        <if test="script != null">script = #{script},</if>
        <if test="variables != null">variables = #{variables},</if>
        update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <select id="selectByStrategyId" parameterType="java.lang.Long" resultMap="ShareStrategyScriptResultMap">
        SELECT * FROM share_strategy_script WHERE strategy_id = #{strategyId}
    </select>

    <delete id="deleteByStrategyId" parameterType="java.lang.Long">
        DELETE FROM share_strategy_script WHERE strategy_id = #{strategyId}
    </delete>
</mapper>
