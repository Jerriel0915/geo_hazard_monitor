<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.monitor.mapper.MonitorTypeMapper">

    <!-- ==================== 结果映射 ==================== -->
    <resultMap type="com.zwei.iot.monitor.domain.MonitorType" id="MonitorTypeResult">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="deviceType" column="device_type"/>
        <result property="icon" column="icon"/>
        <result property="description" column="description"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ==================== SQL片段 ==================== -->
    <sql id="selectMonitorTypeVo">
        SELECT id,
               code,
               name,
               device_type,
               icon,
               description,
               sort_order,
               status,
               del_flag,
               create_by,
               create_time,
               update_by,
               update_time
        FROM monitor_type
    </sql>

    <!-- ==================== 查询操作 ==================== -->

    <!-- 分页查询监测类型列表 -->
    <select id="selectMonitorTypeList" parameterType="com.zwei.iot.monitor.domain.MonitorType"
            resultMap="MonitorTypeResult">
        <include refid="selectMonitorTypeVo"/>
        <where>
            del_flag = 0
            <if test="code != null and code != ''">
                AND code LIKE CONCAT('%', #{code}, '%')
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="deviceType != null">
                AND device_type = #{deviceType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort_order ASC, id ASC
    </select>

    <!-- 查询所有监测类型列表 -->
    <select id="selectMonitorTypeAll" resultMap="MonitorTypeResult">
        <include refid="selectMonitorTypeVo"/>
        WHERE del_flag = 0
        ORDER BY sort_order ASC, id ASC
    </select>

    <!-- 根据ID查询监测类型详情 -->
    <select id="selectMonitorTypeById" parameterType="Long" resultMap="MonitorTypeResult">
        <include refid="selectMonitorTypeVo"/>
        WHERE id = #{id} AND del_flag = 0
    </select>

    <!-- 根据编码查询监测类型 -->
    <select id="selectMonitorTypeByCode" parameterType="String" resultMap="MonitorTypeResult">
        <include refid="selectMonitorTypeVo"/>
        WHERE code = #{code} AND del_flag = 0
    </select>

    <!-- 校验监测类型编码是否唯一 -->
    <select id="checkMonitorTypeCodeUnique" resultMap="MonitorTypeResult">
        <include refid="selectMonitorTypeVo"/>
        WHERE code = #{code} AND del_flag = 0 AND id != #{id} LIMIT 1
    </select>

    <!-- ==================== 新增操作 ==================== -->

    <!-- 新增监测类型 -->
    <insert id="insertMonitorType" parameterType="com.zwei.iot.monitor.domain.MonitorType" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO monitor_type(
        <if test="code != null and code != ''">code,</if>
        <if test="name != null and name != ''">name,</if>
        <if test="deviceType != null">device_type,</if>
        <if test="icon != null">icon,</if>
        <if test="description != null">description,</if>
        <if test="sortOrder != null">sort_order,</if>
        <if test="status != null">status,</if>
        <if test="createBy != null and createBy != ''">create_by,</if>
        create_time
        ) VALUES (
        <if test="code != null and code != ''">#{code},</if>
        <if test="name != null and name != ''">#{name},</if>
        <if test="deviceType != null">#{deviceType},</if>
        <if test="icon != null">#{icon},</if>
        <if test="description != null">#{description},</if>
        <if test="sortOrder != null">#{sortOrder},</if>
        <if test="status != null">#{status},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        SYSDATE()
        )
    </insert>

    <!-- ==================== 修改操作 ==================== -->

    <!-- 修改监测类型 -->
    <update id="updateMonitorType" parameterType="com.zwei.iot.monitor.domain.MonitorType">
        UPDATE monitor_type
        <set>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="deviceType != null">device_type = #{deviceType},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="description != null">description = #{description},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = SYSDATE()
        </set>
        WHERE id = #{id}
    </update>

    <!-- ==================== 删除操作 ==================== -->

    <!-- 删除监测类型（逻辑删除） -->
    <delete id="deleteMonitorTypeById" parameterType="Long">
        UPDATE monitor_type
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE id = #{id}
          AND del_flag = 0
    </delete>

    <!-- 批量删除监测类型（逻辑删除） -->
    <delete id="deleteMonitorTypeByIds" parameterType="Long">
        UPDATE monitor_type
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE del_flag = 0
          AND id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- ==================== 统计查询 ==================== -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM monitor_type
        WHERE del_flag = 0
    </select>

</mapper>
