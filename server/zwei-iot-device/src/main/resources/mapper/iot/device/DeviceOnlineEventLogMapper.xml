<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.device.mapper.DeviceOnlineEventLogMapper">

    <resultMap type="com.zwei.iot.device.domain.DeviceOnlineEventLog" id="DeviceOnlineEventLogResult">
        <id property="id" column="id"/>
        <result property="deviceId" column="device_id"/>
        <result property="eventType" column="event_type"/>
        <result property="clientId" column="client_id"/>
        <result property="clientIp" column="client_ip"/>
        <result property="eventTime" column="event_time"/>
        <result property="reason" column="reason"/>
    </resultMap>

    <select id="selectByDeviceId" resultMap="DeviceOnlineEventLogResult">
        SELECT id, device_id, event_type, client_id, client_ip, event_time, reason
        FROM device_online_event_log
        WHERE device_id = #{deviceId}
        ORDER BY event_time DESC
        LIMIT #{limit}
    </select>
</mapper>
