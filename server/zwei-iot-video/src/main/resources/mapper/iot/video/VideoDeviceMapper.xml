<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zwei.iot.video.mapper.VideoDeviceMapper">

    <resultMap type="com.zwei.iot.video.domain.VideoDevice" id="VideoDeviceResult">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="icon" column="icon"/>
        <result property="iconPath" column="icon_path"/>
        <result property="protocolCode" column="protocol_code"/>
        <result property="protocolName" column="protocol_name"/>
        <result property="streamUrl" column="stream_url"/>
        <result property="status" column="status"/>
        <result property="lastOnlineTime" column="last_online_time"/>
        <result property="installTime" column="install_time"/>
        <result property="longitude" column="longitude"/>
        <result property="latitude" column="latitude"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="hazardPointIds" column="hazard_point_ids"/>
    </resultMap>

    <sql id="selectVideoDeviceVo">
        SELECT vd.id,
               vd.code,
               vd.name,
               vd.icon,
               vd.icon_path,
               vd.protocol_code,
               vd.protocol_name,
               vd.stream_url,
               vd.status,
               vd.last_online_time,
               vd.install_time,
               vd.longitude,
               vd.latitude,
               vd.create_by,
               vd.create_time,
               vd.update_by,
               vd.update_time,
               vd.del_flag,
               (SELECT GROUP_CONCAT(DISTINCT vdhp.hazard_point_id ORDER BY vdhp.hazard_point_id)
                FROM video_device_hazard_point vdhp
                WHERE vdhp.video_device_id = vd.id) AS hazard_point_ids
        FROM video_device vd
    </sql>

    <select id="selectVideoDeviceList" parameterType="com.zwei.iot.video.domain.VideoDevice"
            resultMap="VideoDeviceResult">
        <include refid="selectVideoDeviceVo"/>
        WHERE vd.del_flag = 0
        <if test="code != null and code != ''">
            AND vd.code LIKE CONCAT('%', #{code}, '%')
        </if>
        <if test="name != null and name != ''">
            AND vd.name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="protocolCode != null and protocolCode != ''">
            AND vd.protocol_code = #{protocolCode}
        </if>
        <if test="status != null">
            AND vd.status = #{status}
        </if>
        ORDER BY vd.create_time DESC
    </select>

    <select id="selectVideoDeviceAll" resultMap="VideoDeviceResult">
        <include refid="selectVideoDeviceVo"/>
        WHERE vd.del_flag = 0
        ORDER BY vd.create_time DESC
    </select>

    <select id="selectVideoDeviceById" parameterType="Long" resultMap="VideoDeviceResult">
        <include refid="selectVideoDeviceVo"/>
        WHERE vd.id = #{id} AND vd.del_flag = 0
    </select>

    <insert id="insertVideoDevice" parameterType="com.zwei.iot.video.domain.VideoDevice" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO video_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="icon != null">icon,</if>
            <if test="iconPath != null">icon_path,</if>
            <if test="protocolCode != null">protocol_code,</if>
            <if test="protocolName != null">protocol_name,</if>
            <if test="streamUrl != null">stream_url,</if>
            <if test="status != null">status,</if>
            <if test="installTime != null">install_time,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
            <if test="createBy != null">create_by,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="icon != null">#{icon},</if>
            <if test="iconPath != null">#{iconPath},</if>
            <if test="protocolCode != null">#{protocolCode},</if>
            <if test="protocolName != null">#{protocolName},</if>
            <if test="streamUrl != null">#{streamUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="installTime != null">#{installTime},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="createBy != null">#{createBy},</if>
        </trim>
    </insert>

    <update id="updateVideoDevice" parameterType="com.zwei.iot.video.domain.VideoDevice">
        UPDATE video_device
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="iconPath != null">icon_path = #{iconPath},</if>
            <if test="protocolCode != null">protocol_code = #{protocolCode},</if>
            <if test="protocolName != null">protocol_name = #{protocolName},</if>
            <if test="streamUrl != null">stream_url = #{streamUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lastOnlineTime != null">last_online_time = #{lastOnlineTime},</if>
            <if test="installTime != null">install_time = #{installTime},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </trim>
        WHERE id = #{id}
    </update>

    <update id="deleteVideoDeviceById" parameterType="Long">
        UPDATE video_device
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE id = #{id}
          AND del_flag = 0
    </update>

    <update id="deleteVideoDeviceByIds" parameterType="Long">
        UPDATE video_device
        SET code = CONCAT(LEFT(code, 75), '#DEL#', id),
            del_flag = 1,
            update_time = SYSDATE()
        WHERE del_flag = 0
          AND id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="checkVideoDeviceCodeUnique" resultMap="VideoDeviceResult">
        SELECT id, code, name, del_flag FROM video_device
        WHERE del_flag = 0 AND code = #{code}
        <if test="id != null">
            AND id != #{id}
        </if>
        LIMIT 1
    </select>

    <!-- ==================== 统计查询 ==================== -->
    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM video_device
        WHERE del_flag = 0
    </select>

    <select id="countByStatus" resultType="java.util.Map">
        SELECT status, COUNT(*) AS cnt
        FROM video_device
        WHERE del_flag = 0
        GROUP BY status
    </select>

</mapper>
